<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{44D8D5C9-0D33-4F58-A184-BC0C17F8D8F0}</ProjectGuid>
        <ProjectVersion>20.1</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <MainSource>ConsultaCEP_MVC.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Base</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Application</AppType>
        <ProjectName Condition="'$(ProjectName)'==''">ConsultaCEP_MVC</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>ConsultaCEP_MVC</SanitizedProjectName>
        <Icon_MainIcon>$(BDS)\bin\delphi_PROJECTICON.ico</Icon_MainIcon>
        <DCC_Namespace>System;Winapi;Xml;Data;Datasnap;Web;Soap;Vcl;FireDAC;REST;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>Source\Bootstrap;Source\Controller;Source\Domain;Source\Integration;Source\Persistence;Source\Service;Source\View;Source\Infra;C:\componentes\Spring4D\Source;C:\componentes\Spring4D\Source\Base;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug'">
        <DCC_DebugInformation>true</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_UnitSearchPath>Source\Bootstrap;Source\Controller;Source\Domain;Source\Integration;Source\Persistence;Source\Service;Source\View;Source\Infra;C:\componentes\Spring4D\Source;C:\componentes\Spring4D\Source\Base;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release'">
        <DCC_DebugInformation>false</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_UnitSearchPath>Source\Bootstrap;Source\Controller;Source\Domain;Source\Integration;Source\Persistence;Source\Service;Source\View;Source\Infra;C:\componentes\Spring4D\Source;C:\componentes\Spring4D\Source\Base;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Source\Bootstrap\App.Registration.pas"/>
        <DCCReference Include="Source\Controller\ConsultaCEP.Controller.pas"/>
        <DCCReference Include="Source\Domain\ConsultaCEP.CEP.pas"/>
        <DCCReference Include="Source\Domain\ConsultaCEP.DTO.pas"/>
        <DCCReference Include="Source\Domain\ConsultaCEP.Interfaces.pas"/>
        <DCCReference Include="Source\Infra\ConsultaCEP.Logger.pas"/>
        <DCCReference Include="Source\Integration\ConsultaCEP.Gateway.BrasilAPI.pas"/>
        <DCCReference Include="Source\Integration\ConsultaCEP.Gateway.ViaCEP.pas"/>
        <DCCReference Include="Source\Persistence\ConsultaCEP.Repository.FireDAC.pas"/>
        <DCCReference Include="Source\Service\ConsultaCEP.Service.pas"/>
        <DCCReference Include="Source\View\ConsultaCEP.View.Main.pas">
            <Form>FormMain</Form>
        </DCCReference>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">ConsultaCEP_MVC.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
